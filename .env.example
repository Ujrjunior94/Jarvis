# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AI Provider Configuration (gemini | openrouter | openai | heuristic)
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"
AI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Memory / Database Configuration (Supabase / PostgreSQL)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
DATABASE_URL=""

# External System Integrations (Leave empty to use decoupled MOCK adapters in V1)
POSTO_ADM_API_URL=""
POSTO_ADM_API_TOKEN=""

ROTAPLANNER_API_URL=""
ROTAPLANNER_API_TOKEN=""

CONTROLE_GASTOS_API_URL=""
CONTROLE_GASTOS_API_TOKEN=""

