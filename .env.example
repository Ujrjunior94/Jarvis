# GEMINI_API_KEY: Chave para chamadas ao Google Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o app está hospedado
APP_URL="MY_APP_URL"

# Provedor de IA ativo (gemini | openrouter | openai | heuristic)
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"
AI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Banco de Dados / Memória (Supabase / PostgreSQL)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
DATABASE_URL=""

# Integrações de Sistemas (deixe vazio para usar Mocks em desenvolvimento)
POSTO_ADM_API_URL=""
POSTO_ADM_API_TOKEN=""

ROTAPLANNER_API_URL=""
ROTAPLANNER_API_TOKEN=""

CONTROLE_GASTOS_API_URL=""
CONTROLE_GASTOS_API_TOKEN=""

