# ==============================================================================
# JARVIS — Configurações de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha conforme necessário.
# NUNCA insira chaves secretas diretamente neste arquivo de exemplo.
# ==============================================================================

# --- SERVIÇO & HOSPEDAGEM ---
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"

# --- PROVEDOR DE IA (DESACOPLADO) ---
# Opções para AI_PROVIDER: gemini | openrouter | openai | heuristic
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"

# Chaves de API para os Provedores de IA suportados:
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
AI_API_KEY=""
OPENAI_API_KEY=""

# --- BANCO DE DADOS & MEMÓRIA PERSISTENTE ---
# Configuração para Supabase / PostgreSQL (Memória de Curto e Longo Prazo)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
DATABASE_URL=""

# --- SISTEMAS CONECTADOS (ORQUESTRAÇÃO DESACOPLADA) ---
# Sistema 1: POSTO ADM (https://github.com/Ujrjunior94/Projeto-posto1)
# Deixe vazio para operar em Modo MOCK isolado durante testes locais
POSTO_ADM_API_URL=""
POSTO_ADM_API_TOKEN=""

# Sistema 2: ROTAPLANNER (https://github.com/Ujrjunior94/Rotaplanner)
# Deixe vazio para operar em Modo MOCK isolado durante testes locais
ROTAPLANNER_API_URL=""
ROTAPLANNER_API_TOKEN=""

# Sistema 3: CONTROLE DE GASTOS (Repositório Futuro)
# Módulo estruturado pronto para acoplamento assim que a API for publicada
CONTROLE_GASTOS_API_URL=""
CONTROLE_GASTOS_API_TOKEN=""


